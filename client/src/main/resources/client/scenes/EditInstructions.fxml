<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="840.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.EditInstructionsCtrl">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <children>
      <MenuButton fx:id="languageButton" focusTraversable="false" mnemonicParsing="false" text="English" />

      <HBox prefHeight="5.0" prefWidth="560.0" spacing="10.0" />

      <HBox prefHeight="29.0" prefWidth="800.0">
         <children>
            <Label text="%editInstructions.title">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Label text="%editIngredients.recipe.label">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Label fx:id="recipeName" prefHeight="5.0" prefWidth="258.0" text="%editIngredients.recipeName.placeholder">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </HBox>

      <Separator prefWidth="200.0" />

      <ListView fx:id="instructionList" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

      <HBox prefHeight="67.0" prefWidth="800.0" spacing="10.0">
         <children>
            <Button fx:id="addButton" mnemonicParsing="false" onAction="#addInstruction" prefHeight="26.0" prefWidth="137.0" text="%button.add" />
            <Button fx:id="editButton" mnemonicParsing="false" onAction="#editInstruction" prefHeight="26.0" prefWidth="134.0" text="%button.edit" />
            <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteInstruction" prefHeight="26.0" prefWidth="129.0" text="%button.delete" />
         </children>
      </HBox>

      <HBox prefHeight="30.0" prefWidth="560.0" spacing="380.0">
         <children>
            <Button mnemonicParsing="false" onAction="#returnToMainUI" prefHeight="26.0" prefWidth="218.0" text="%editInstructions.backToMain" />
            <Button fx:id="saveChanges" mnemonicParsing="false" onAction="#saveChanges" prefHeight="26.0" prefWidth="236.0" text="%editInstructions.saveChanges" />
         </children>
      </HBox>
   </children>
</VBox>
