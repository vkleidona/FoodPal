<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.InformationCtrl">

    <children>
        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="407.0" prefWidth="781.0" VBox.vgrow="ALWAYS">
            <children>

                <MenuButton fx:id="languageButton" layoutX="25.0" layoutY="11.0" mnemonicParsing="false" text="English" />

                <Label fx:id="caloriesLabel" layoutX="24.0" layoutY="56.0" text="%info.caloriesPer100">
                    <font><Font size="16.0" /></font>
                </Label>

                <Label fx:id="proteinsLabel" layoutX="23.0" layoutY="90.0" text="%info.proteinsPer100">
                    <font><Font size="16.0" /></font>
                </Label>

                <Label fx:id="carbsLabel" layoutX="23.0" layoutY="124.0" text="%info.carbsPer100">
                    <font><Font size="16.0" /></font>
                </Label>

                <Label fx:id="fatsLabel" layoutX="25.0" layoutY="159.0" text="%info.fatsPer100">
                    <font><Font size="16.0" /></font>
                </Label>

                <Button layoutX="743.0" layoutY="496.0" mnemonicParsing="false" onAction="#handleCancel" prefHeight="26.0" prefWidth="82.0" text="%button.cancel" />

                <Label layoutX="518.0" layoutY="56.0" text="%info.servings">
                    <font><Font size="16.0" /></font>
                </Label>

                <ScrollPane layoutX="25.0" layoutY="196.0" prefHeight="268.0" prefWidth="796.0">
                    <content>
                        <VBox fx:id="ingredientsContainer" prefHeight="218.0" prefWidth="740.0" />
                    </content>
                </ScrollPane>

                <TextField fx:id="servingsField" layoutX="686.0" layoutY="55.0" onAction="#handleServingsChange" prefHeight="26.0" prefWidth="30.0" />

                <Label layoutX="518.0" layoutY="90.0" text="%info.caloriesRecipe">
                    <font><Font size="16.0" /></font>
                </Label>

                <TextField fx:id="caloriesRecipe" layoutX="686.0" layoutY="89.0" onAction="#handleCaloriesRecipe" prefHeight="26.0" prefWidth="82.0" />
            </children>
        </AnchorPane>
    </children>
</VBox>
