<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="560.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.CreateRecipeCtrl">

    <children>
        <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="555.0" prefWidth="802.0" VBox.vgrow="ALWAYS">
            <children>

                <Label layoutX="30.0" layoutY="100.0" text="%create.name.label">
                    <font><Font size="18.0" /></font>
                </Label>

                <Label layoutX="28.0" layoutY="144.0" text="%create.ingredients.label">
                    <font><Font size="18.0" /></font>
                </Label>

                <ScrollPane layoutX="29.0" layoutY="188.0" prefHeight="126.0" prefWidth="758.0">
                    <content>
                        <VBox fx:id="ingredientsVBox" prefHeight="126.0" prefWidth="745.0" />
                    </content>
                </ScrollPane>

                <Button fx:id="addIngredientButton" layoutX="176.0" layoutY="143.0" mnemonicParsing="false" onAction="#handleAddIngredient" text="+">
                    <font><Font size="14.0" /></font>
                </Button>

                <Label layoutX="28.0" layoutY="323.0" prefHeight="27.0" prefWidth="100.0" text="%create.instructions.label">
                    <font><Font size="18.0" /></font>
                </Label>

                <Button fx:id="addPreparationButton" layoutX="176.0" layoutY="322.0" mnemonicParsing="false" onAction="#handleAddPreparation" text="+">
                    <font><Font size="14.0" /></font>
                </Button>

                <ScrollPane layoutX="30.0" layoutY="359.0" prefHeight="126.0" prefWidth="769.0">
                    <content>
                        <VBox fx:id="preparationVBox" prefHeight="126.0" prefWidth="746.0" />
                    </content>
                </ScrollPane>

                <Button fx:id="cancelButton" layoutX="669.0" layoutY="502.0" mnemonicParsing="false" onAction="#handleCancel" text="%button.cancel">
                    <font><Font size="14.0" /></font>
                </Button>

                <TextField fx:id="nameTextField" layoutX="94.0" layoutY="98.0" prefHeight="30.0" prefWidth="297.0">
                    <font><Font size="14.0" /></font>
                </TextField>

                <Button fx:id="applyButton" layoutX="759.0" layoutY="502.0" mnemonicParsing="false" onAction="#handleApply" text="%button.apply">
                    <font><Font size="14.0" /></font>
                </Button>

                <RadioButton fx:id="metricRadioButton" layoutX="232.0" layoutY="149.0" mnemonicParsing="false" onAction="#handleSystemChange" selected="true" text="%create.system.metric">
                    <toggleGroup>
                        <ToggleGroup fx:id="systemGroup" />
                    </toggleGroup>
                </RadioButton>

                <RadioButton fx:id="imperialRadioButton" layoutX="310.0" layoutY="149.0" mnemonicParsing="false" onAction="#handleSystemChange" text="%create.system.imperial" toggleGroup="$systemGroup" />

                <RadioButton fx:id="kitchenRadioButton" layoutX="400.0" layoutY="149.0" mnemonicParsing="false" onAction="#handleSystemChange" text="%create.system.kitchen" toggleGroup="$systemGroup" />

                <Label layoutX="469.0" layoutY="100.0" text="%create.servings.label">
                    <font><Font size="17.0" /></font>
                </Label>

                <TextField fx:id="servingsTextField" focusTraversable="false" layoutX="639.0" layoutY="101.0" prefHeight="18.0" prefWidth="37.0" />

                <Button fx:id="refreshButton" layoutX="603.0" layoutY="138.0" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="26.0" prefWidth="36.0" text="↻">
                    <font><Font size="18.0" /></font>
                </Button>

                <!-- Language button: items added in controller -->
                <MenuButton fx:id="languageButton" focusTraversable="false" layoutX="28.0" layoutY="43.0" mnemonicParsing="false" text="English" />
            </children>
        </AnchorPane>
    </children>
</VBox>
