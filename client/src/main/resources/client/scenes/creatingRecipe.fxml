<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="870.4" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.CreateRecipeCtrl">
  <children>
    <MenuBar prefHeight="54.0" prefWidth="826.0" VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="File">
          <items>
            <MenuItem mnemonicParsing="false" text="New" />
            <MenuItem mnemonicParsing="false" text="Open…" />
            <Menu mnemonicParsing="false" text="Open Recent" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Close" />
            <MenuItem mnemonicParsing="false" text="Save" />
            <MenuItem mnemonicParsing="false" text="Save As…" />
            <MenuItem mnemonicParsing="false" text="Revert" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Preferences…" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Quit" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
          <items>
            <MenuItem mnemonicParsing="false" text="Undo" />
            <MenuItem mnemonicParsing="false" text="Redo" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Cut" />
            <MenuItem mnemonicParsing="false" text="Copy" />
            <MenuItem mnemonicParsing="false" text="Paste" />
            <MenuItem mnemonicParsing="false" text="Delete" />
            <SeparatorMenuItem mnemonicParsing="false" />
            <MenuItem mnemonicParsing="false" text="Select All" />
            <MenuItem mnemonicParsing="false" text="Unselect All" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About MyHelloApp" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
      <AnchorPane fx:id="AnchorPane">
         <children>
            <VBox prefWidth="870.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Label contentDisplay="CENTER" prefHeight="27.0" prefWidth="62.0" text="Name: ">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="20.0" left="20.0" top="15.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="nameTextField" prefHeight="33.0" prefWidth="483.0">
                     <VBox.margin>
                        <Insets bottom="22.0" left="100.0" right="250.0" top="-48.0" />
                     </VBox.margin>
                  </TextField>
                  <Label contentDisplay="CENTER" prefHeight="27.0" prefWidth="130.0" text="Ingredients:">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets left="20.0" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="addIngredientButton" mnemonicParsing="false" onAction="#handleAddIngredient" prefHeight="20.0" prefWidth="32.0" text="+">
                     <VBox.margin>
                        <Insets left="150.0" right="18.0" top="-30.0" />
                     </VBox.margin>
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Button>
                  <RadioButton fx:id="metricRadioButton" mnemonicParsing="false" onAction="#handleSystemChange" prefHeight="22.0" prefWidth="78.0" selected="true" text="Metric">
                     <VBox.margin>
                        <Insets left="220.0" right="18.0" top="-30.0" />
                     </VBox.margin>
                     <toggleGroup>
                        <ToggleGroup fx:id="systemGroup" />
                     </toggleGroup>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </RadioButton>
                  <RadioButton fx:id="imperialRadioButton" mnemonicParsing="false" onAction="#handleSystemChange" prefHeight="22.0" prefWidth="92.0" text="Imperial" toggleGroup="$systemGroup">
                     <VBox.margin>
                        <Insets left="315.0" right="18.0" top="-23.0" />
                     </VBox.margin>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </RadioButton>
                  <RadioButton fx:id="kitchenRadioButton" mnemonicParsing="false" onAction="#handleSystemChange" prefHeight="22.0" prefWidth="213.0" text="Common / Kitchen / Other" toggleGroup="$systemGroup">
                     <VBox.margin>
                        <Insets left="415.0" top="-22.5" />
                     </VBox.margin>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </RadioButton>
                  <ScrollPane prefHeight="158.0" prefWidth="742.0" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="10.0" left="50.0" right="50.0" top="20.0" />
                     </VBox.margin>
                     <content>
                        <VBox fx:id="ingredientsVBox" prefHeight="131.0" prefWidth="757.0" />
                     </content>
                  </ScrollPane>
                  <Label contentDisplay="CENTER" prefHeight="27.0" prefWidth="130.0" text="Instructions:">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" left="20.0" />
                     </VBox.margin>
                  </Label>
                  <ScrollPane prefHeight="146.0" prefWidth="758.0" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="25.0" left="50.0" right="50.0" />
                     </VBox.margin>
                     <content>
                        <VBox fx:id="preparationVBox" prefHeight="121.0" prefWidth="731.0" />
                     </content>
                  </ScrollPane>
                  <Button fx:id="applyButton" mnemonicParsing="false" onAction="#handleApply" prefHeight="23.0" prefWidth="59.0" text="Apply" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="10.0" left="785.0" right="25.0" />
                     </VBox.margin>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="15.0" left="680.0" top="-41.0" />
                     </VBox.margin>
                     <font>
                        <Font size="15.0" />
                     </font>
                  </Button>
               </children>
            </VBox>
         </children>
      </AnchorPane>
  </children>
</VBox>
