<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.shopping_list.AddRecipeToShoppingListCtrl">

    <children>
        <HBox layoutX="162.0" layoutY="34.0" prefHeight="58.0" prefWidth="640.0">
            <children>
                <Label fx:id="shoppingListLabel" alignment="CENTER" prefHeight="46.0" prefWidth="249.0" text="%addRecipeToShoppingList.title">
                    <font>
                        <Font size="24.0" />
                    </font>
                    <HBox.margin>
                        <Insets left="120.0" top="5.0" />
                    </HBox.margin>
                </Label>
                <Button fx:id="backButton" mnemonicParsing="false" onAction="#returnToMainUI" prefHeight="29.0" prefWidth="59.0" text="%button.back">
                    <HBox.margin>
                        <Insets left="200.0" top="15.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>

        <ScrollPane layoutX="100.0" layoutY="113.0" prefHeight="348.0" prefWidth="614.0">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="335.0" prefWidth="606.0">
                    <children>
                        <ListView fx:id="recipeIngredientsListView" layoutY="2.0" prefHeight="329.0" prefWidth="606.0" />
                    </children>
                </AnchorPane>
            </content>
        </ScrollPane>

        <HBox layoutX="108.0" layoutY="499.0" prefHeight="46.0" prefWidth="762.0">
            <children>
                <Button fx:id="plusButton" mnemonicParsing="false" onAction="#addIngredientThroughPlusButton" prefHeight="38.0" prefWidth="61.0" text="+">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
                <Button fx:id="confirmButton" mnemonicParsing="false" onAction="#confirmAction" prefHeight="38.0" prefWidth="150.0" text="%button.confirm">
                    <HBox.margin>
                        <Insets left="400.0" />
                    </HBox.margin>
                    <font>
                        <Font size="16.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <!-- Language button: items will be added in controller -->
        <MenuButton fx:id="languageButton" focusTraversable="false" layoutX="23.0" layoutY="50.0" mnemonicParsing="false" text="English">
        </MenuButton>
    </children>
</AnchorPane>
