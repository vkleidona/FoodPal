<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="840.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.EditIngredientsCtrl">

    <children>
        <Label layoutX="421.0" layoutY="54.0" prefHeight="17.0" prefWidth="62.0" text="%editIngredients.recipe.label">
            <font><Font size="18.0" /></font>
        </Label>

        <TableView fx:id="listOfIngredients" editable="true" layoutX="7.0" layoutY="111.0" onMouseClicked="#rowClicked" prefHeight="433.0" prefWidth="337.0">
            <columns>
                <TableColumn fx:id="ingredientNameColumn" prefWidth="79.0" text="%editIngredients.column.name" />
                <TableColumn fx:id="quantityColumn" prefWidth="140.0" text="%editIngredients.column.quantity" />
                <TableColumn fx:id="measurementColumn" prefWidth="75.0" text="%editIngredients.column.unit" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Button layoutX="427.0" layoutY="345.0" mnemonicParsing="false" onAction="#addIngredient" prefHeight="35.0" prefWidth="316.0" text="%button.add" />

        <Button layoutX="427.0" layoutY="404.0" mnemonicParsing="false" onAction="#removeIngredient" prefHeight="35.0" prefWidth="316.0" text="%button.remove" />

        <ComboBox fx:id="inputFoodName" editable="true" layoutX="504.0" layoutY="115.0" prefHeight="35.0" prefWidth="239.0" />

        <TextField fx:id="inputQuantity" layoutX="504.0" layoutY="160.0" prefHeight="35.0" prefWidth="239.0" />

        <Label layoutX="421.0" layoutY="120.0" prefHeight="25.0" prefWidth="55.0" text="%editIngredients.name.label" />

        <Label layoutX="417.0" layoutY="160.0" prefHeight="27.0" prefWidth="64.0" text="%editIngredients.quantity.label" />

        <Label layoutX="419.0" layoutY="205.0" text="%editIngredients.unitSystem.label" />

        <HBox layoutX="12.0" layoutY="59.0" prefHeight="41.0" prefWidth="123.0">
            <children>
                <Label text="%editIngredients.title">
                    <font><Font size="18.0" /></font>
                </Label>
            </children>
        </HBox>

        <Label layoutX="426.0" layoutY="244.0" prefHeight="25.0" prefWidth="45.0" text="%editIngredients.unit.label" />

        <Button layoutX="427.0" layoutY="288.0" mnemonicParsing="false" onAction="#submitEdit" prefHeight="35.0" prefWidth="316.0" text="%button.update" />

        <Label fx:id="errorLabel" alignment="CENTER" layoutX="425.0" layoutY="336.0" prefHeight="17.0" prefWidth="149.0" textFill="RED" />

        <Label fx:id="recipeName" layoutX="485.0" layoutY="54.0" text="%editIngredients.recipeName.placeholder">
            <font><Font size="18.0" /></font>
        </Label>

        <RadioButton fx:id="metric" layoutX="500.0" layoutY="205.0" mnemonicParsing="false" onAction="#handleSystemChange" prefHeight="17.0" prefWidth="62.0" text="%create.system.metric">
            <toggleGroup>
                <ToggleGroup fx:id="unitGroup" />
            </toggleGroup>
        </RadioButton>

        <RadioButton fx:id="imperial" layoutX="574.0" layoutY="205.0" mnemonicParsing="false" onAction="#handleSystemChange" text="%create.system.imperial" toggleGroup="$unitGroup" />

        <RadioButton fx:id="common" layoutX="668.0" layoutY="205.0" mnemonicParsing="false" onAction="#handleSystemChange" text="%editIngredients.system.common" toggleGroup="$unitGroup" />

        <Separator layoutX="338.0" layoutY="-3.0" orientation="VERTICAL" prefHeight="433.0" prefWidth="25.0" />

        <ComboBox fx:id="inputMeasurement" editable="true" layoutX="500.0" layoutY="239.0" prefHeight="35.0" prefWidth="239.0" />

        <Button layoutX="427.0" layoutY="461.0" mnemonicParsing="false" onAction="#resetForm" prefHeight="35.0" prefWidth="316.0" text="%button.clear" />

        <Button layoutX="393.0" layoutY="512.0" mnemonicParsing="false" onAction="#cancelEdit" prefHeight="25.0" prefWidth="56.0" text="%button.back" />

        <Button layoutX="743.0" layoutY="512.0" mnemonicParsing="false" onAction="#applyEdit" prefHeight="25.0" prefWidth="65.0" text="%button.apply" />

        <MenuButton fx:id="languageButton" focusTraversable="false" layoutX="12.0" layoutY="14.0" mnemonicParsing="false" text="English" />
    </children>
</Pane>
