<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="841.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.MainUICtrl">

    <!-- Top bar with window controls -->
    <top>
      <VBox spacing="10.0">
         <children>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="%app.title">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <padding>
                  <Insets top="6.0" />
               </padding>
            </Label>
              <HBox prefHeight="56.0" prefWidth="841.0" spacing="10">
                  <Button fx:id="refreshButton" text="⟳">
                  <HBox.margin>
                     <Insets left="2.0" />
                  </HBox.margin></Button>
                  <!-- Language button: items will be added in controller -->
                  <MenuButton fx:id="languageButton" focusTraversable="false" mnemonicParsing="false" prefHeight="26.0" prefWidth="96.0" text="English">
            </MenuButton>
               <MenuButton fx:id="filterLanguagesButton" mnemonicParsing="false" onAction="#setupFilterLanguages" prefHeight="26.0" prefWidth="112.0" text="%filter.languages">
                 <items>
                   <MenuItem mnemonicParsing="false" text="Action 1" />
                   <MenuItem mnemonicParsing="false" text="Action 2" />
                 </items>
               </MenuButton>
                  <TextField fx:id="recipeSearchBar" onAction="#searchForRecipe" prefHeight="26.0" prefWidth="566.0" promptText="%search.bar.prompt">
                  <HBox.margin>
                     <Insets />
                  </HBox.margin>
               </TextField>
              </HBox>
         </children>
      </VBox>
    </top>

    <!-- Left sidebar -->
    <left>
        <VBox prefWidth="200" spacing="5">
            <HBox prefHeight="36.0" prefWidth="200.0">
                <children>
                    <ToggleButton fx:id="allRecipesTab" mnemonicParsing="false" onAction="#showAllRecipes" text="%tab.allRecipes">
                        <toggleGroup>
                            <ToggleGroup fx:id="group" />
                        </toggleGroup>
                  <HBox.margin>
                     <Insets left="2.0" />
                  </HBox.margin>
                    </ToggleButton>
                    <ToggleButton fx:id="favoritesTab" mnemonicParsing="false" onAction="#showFavoriteRecipes" text="%tab.favorites" toggleGroup="$group" />
                </children>
            </HBox>
            <ListView fx:id="recipeListView" VBox.vgrow="ALWAYS">
            <VBox.margin>
               <Insets left="2.0" />
            </VBox.margin></ListView>
            <HBox spacing="10">
                <Button fx:id="addRecipeButton" text="+">
               <HBox.margin>
                  <Insets bottom="2.0" left="2.0" />
               </HBox.margin></Button>
                <Button fx:id="deleteRecipeButton" text="-" />
            </HBox>
        </VBox>
    </left>

    <!-- Right main content -->
    <center>
        <AnchorPane prefHeight="535.0" prefWidth="641.0">

            <!-- Recipe Name -->
            <Label layoutX="13.0" layoutY="9.0" text="%label.recipeName" />
            <Label fx:id="recipeNameLabel" layoutX="110" layoutY="10" />
            <Button fx:id="editNameButton" layoutX="300" layoutY="5" text="%button.edit" />

            <!-- Ingredients -->
            <Label layoutX="15.0" layoutY="93.0" text="%label.ingredients" />
            <Button fx:id="editIngredientsButton" layoutX="300.0" layoutY="89.0" text="%button.edit" />
            <ScrollPane fx:id="ingredientsScrollPane" layoutX="10.0" layoutY="127.0" prefHeight="150" prefWidth="570.0">
                <VBox fx:id="ingredientsVBox" spacing="5" />
            </ScrollPane>

            <!-- Instructions -->
            <Label layoutX="14.0" layoutY="291.0" text="%label.instructions" />
            <Button fx:id="editInstructionsButton" layoutX="297.0" layoutY="287.0" text="%button.edit" />
            <ScrollPane fx:id="instructionsScrollPane" layoutX="14.0" layoutY="325.0" prefHeight="150" prefWidth="566.0">
                <VBox fx:id="instructionsVBox" spacing="5" />
            </ScrollPane>

            <!-- Bottom buttons / labels -->
            <Button fx:id="foodItemButton" layoutX="14.0" layoutY="491.0" text="%button.goToFoodItems" />
            <Button fx:id="shoppingListButton" layoutX="189.0" layoutY="490.0" mnemonicParsing="false" onAction="#handleGoToShoppingList" prefHeight="26.0" prefWidth="149.0" text="%button.shoppingList" />
            <Button fx:id="downloadButton" layoutX="372.0" layoutY="490.0" mnemonicParsing="false" onAction="#downloadRecipe" prefHeight="26.0" prefWidth="97.0" text="%button.download" />
            <Button fx:id="addToShoppingListButton" layoutX="446.0" layoutY="6.0" mnemonicParsing="false" onAction="#handleAddRecipeToShoppingList" text="%button.addToShoppingList" />
            <Button layoutX="454.0" layoutY="89.0" mnemonicParsing="false" onAction="#handleInformation" text="%button.information" />
            <Label layoutX="14.0" layoutY="56.0" text="%label.servings" />
            <Label fx:id="servingsLabel" layoutX="301.0" layoutY="56.0">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
            <ToggleButton fx:id="favoriteButton" layoutX="209.0" layoutY="5.0" mnemonicParsing="false" onAction="#toggleFavorite" text="☆" />
            <Button layoutX="482.0" layoutY="490.0" mnemonicParsing="false" onAction="#cloneRecipe" prefHeight="26.0" prefWidth="94.0" text="%button.clone" />
         <ImageView fx:id="languageIndicator" fitHeight="27.0" fitWidth="27.0" layoutX="250.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" />

        </AnchorPane>
    </center>

</BorderPane>
