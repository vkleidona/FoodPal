<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="800" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.MainUICtrl">

    <!-- Top bar with window controls -->
    <top>
        <HBox spacing="10">
            <Button fx:id="refreshButton" text="⟳" />
            <Button fx:id="minimizeButton" text="_" />
            <Button fx:id="maximizeButton" text="[]" />
            <Button fx:id="exitButton" text="X" />
        </HBox>
    </top>

    <!-- Left sidebar -->
    <left>
        <VBox prefWidth="200" spacing="5">
            <ListView fx:id="recipeListView" VBox.vgrow="ALWAYS" />
            <HBox spacing="10">
                <Button fx:id="addRecipeButton" text="+" />
                <Button fx:id="deleteRecipeButton" text="-" />
            </HBox>
        </VBox>
    </left>

    <!-- Right main content -->
    <center>
        <AnchorPane>

            <!-- Recipe Name -->
            <Label layoutX="10" layoutY="10" text="Recipe Name:" />
            <Label fx:id="recipeNameLabel" layoutX="110" layoutY="10" />
            <Button fx:id="editNameButton" layoutX="300" layoutY="5" text="Edit" />

            <!-- Ingredients -->
            <Label layoutX="10" layoutY="50" text="Ingredients:" />
            <Button fx:id="editIngredientsButton" layoutX="300" layoutY="45" text="Edit" />
            <ScrollPane fx:id="ingredientsScrollPane" layoutX="10" layoutY="75" prefHeight="150" prefWidth="500">
                <VBox fx:id="ingredientsVBox" spacing="5" />
            </ScrollPane>

            <!-- Instructions -->
            <Label layoutX="10" layoutY="240" text="Instructions:" />
            <Button fx:id="editInstructionsButton" layoutX="300" layoutY="235" text="Edit" />
            <ScrollPane fx:id="instructionsScrollPane" layoutX="10" layoutY="270" prefHeight="150" prefWidth="500">
                <VBox fx:id="instructionsVBox" spacing="5" />
            </ScrollPane>

            <!-- Food Items Button -->
            <Button fx:id="foodItemButton" layoutX="10" layoutY="430" text="Go to Food Items" />
         <Button fx:id="shoppingListButton" layoutX="136.0" layoutY="429.0" mnemonicParsing="false" onAction="#handleGoToShoppingList" prefHeight="26.0" prefWidth="106.0" text="Shopping List" />

        </AnchorPane>
    </center>

</BorderPane>
